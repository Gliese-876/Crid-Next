<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_course_body" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingBottom="8dp">
    <FrameLayout android:id="@+id/widget_course_surface" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_course_fill" android:clipChildren="true" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_course_holiday" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_holiday_hatch" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
    <ImageView android:id="@+id/widget_course_accent" android:layout_width="3dp" android:layout_height="match_parent"
        android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_course_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="12dp">
        <TextView android:id="@+id/widget_course_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/widget_course_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="3" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_course_location" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:paddingTop="2dp" />
        <TextView android:id="@+id/widget_course_teacher" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_course_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="2dp" />
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
