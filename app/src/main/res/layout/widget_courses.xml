<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_frame" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layout_gravity="center"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:paddingBottom="4dp">
        <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/platform_today" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#1C1F27" />
        <TextView android:id="@+id/widget_subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:paddingStart="8dp" android:gravity="end" android:textColor="#565E6E" />
    </LinearLayout>
    <FrameLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/widget_compact" android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" />
        <ListView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="vertical" />
        <FrameLayout android:id="@+id/widget_empty_panel" android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:text="@string/platform_no_plan" android:textColor="#565E6E" android:textSize="14sp" android:gravity="center_vertical" android:includeFontPadding="false" />
    </FrameLayout>
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="8dp"
        android:textColor="#565E6E" android:visibility="gone" />
</LinearLayout>
</FrameLayout>
