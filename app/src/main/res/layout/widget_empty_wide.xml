<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_empty_scene" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">
    <ImageView android:id="@+id/widget_empty_art" android:layout_width="120dp" android:layout_height="80dp"
        android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_empty_caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:textSize="16sp" android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" android:paddingStart="12dp" />
</LinearLayout>
